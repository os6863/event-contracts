{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["v0.0.0.1/**/*.ts", "v0.0.0.2/**/*.ts", "v0.0.0.3/**/*.ts", "v0.0.0.4/**/*.ts", "v0.0.0.5/**/*.ts", "v0.0.0.7/**/*.ts"]
}
