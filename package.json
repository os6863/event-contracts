{
  "name": "event-contracts-mispricing-detector",
  "version": "0.0.0.10",
  "private": true,
  "description": "EdgeScope: a DreamDEX Event Contracts mispricing detector using verifiably executed Somnia Agent estimates.",
  "type": "module",
  "scripts": {
    "generate-wallet": "tsx scripts/generate-wallet.ts",
    "report": "tsx src/mispricing-report.ts",
    "check-outcomes": "tsx src/check-outcomes.ts",
    "render-report": "tsx src/mispricing-report.ts --render-only",
    "test": "tsx --test src/tests.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.29.0",
    "viem": "^2.21.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.5.0"
  }
}
