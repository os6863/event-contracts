# --- DreamDEX / Somnia testnet ---
# Chain: Somnia Shannon Testnet (50312) — used via the SDK's own `somniaShannon` chain object.
# These are the values the @somnia-chain/markets-sdk README documents for testnet.
# indexerUrl is the SDK's GraphQL indexer (NOT the spot-only REST API at api.dreamdex.io).
SOMNIA_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# The indexer above is SHARED across many venues (thousands, per the SDK's
# own docs) — DreamDEX is one of them. Without this set, market-scanner.ts
# refuses to guess and instead prints the venue ids it actually sees so you
# can pick the right one.
#
# Known DreamDEX TESTNET venue id as of this writing (dreamdex-bot-kit docs).
# ⚠️ Venue ids are NOT permanent — they have rotated multiple times in the
# past. If the scanner reports 0 markets, run it once with this line removed
# (or commented out) to see the current candidates, then update this value.
SOMNIA_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Never commit your real .env file — only .env.example goes to git.

# --- Somnia Agents (used from v0.0.0.2 onward) ---
# The platform contract every agent invocation goes through (same on every
# agent — this is NOT specific to the price agent). Verified against the
# official Agent Explorer's generated code, Sep 2026.
SOMNIA_AGENTS_CONTRACT=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776

# Comma-separated list of RPC endpoints the script tries in order,
# automatically failing over to the next one if one errors (e.g. rate
# limited, temporarily down). No need to edit this unless ALL of the
# defaults are down — the script already tries both official testnet RPCs.
SOMNIA_AGENT_RPC_URLS=https://dream-rpc.somnia.network/,https://api.infra.testnet.somnia.network/

# Official Receipts Service — how results are read back after a request
# finalizes. On-chain request data gets pruned almost immediately after
# finalization, so results are NOT read via a contract call; this service
# is the documented, correct way (docs.somnia.network/agents/invoking-agents/receipts).
SOMNIA_RECEIPTS_SERVICE_URL=https://receipts.testnet.agents.somnia.host

# REQUIRED from v0.0.0.2 onward — this version WRITES to the chain
# (createRequest is a transaction), unlike v0.0.0.1 which only reads.
#
# ⚠️ Use a FRESH, DISPOSABLE wallet — never your real one.
#   1. Run `npm run generate-wallet` to create one (no MetaMask needed).
#   2. Fund the printed ADDRESS with free STT (confirmed working):
#      https://cloud.google.com/application/web3/faucet/somnia/shannon
#      (network is pre-set to "Somnia Shannon" — no wallet connection needed,
#      just paste the address. testnet.somnia.network's own faucet button
#      did not work as of this writing.)
#   3. Paste the printed PRIVATE KEY below.
# This wallet will only ever hold a small amount of free testnet STT.
PRIVATE_KEY=

# --- External data (free tier, no key needed) ---
# Optional override — the script already defaults to this exact URL if unset.
COINGECKO_URL_PRICES=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=usd

# Optional (v0.0.0.4 onward): cap how many live markets get an LLM
# probability estimate per run. Each market costs ~0.24 STT in LLM calls —
# useful to limit while testing. Unset = analyze every live market found.
MAX_MARKETS=

# Optional: set to "false" to revert to the original single-source
# (CoinGecko-only) price fetch. Defaults to "true" — each price is the
# median of CoinGecko, Binance and Coinbase, each read through its own
# on-chain JSON API Request Agent call (still fully verifiable, just 3x
# the agent calls and cost per unique asset instead of 1x). Turn this off
# if the shared testnet Agent is under heavy contention and you need a
# faster, cheaper run.
MULTI_SOURCE_PRICE=

# Optional: set to "false" to revert to the fixed disclosed volatility
# assumption (BTC 55% / ETH 70% annualized). Defaults to "true" — the naive
# baseline uses realized volatility computed from 7 days of hourly Binance
# klines instead, falling back to the fixed assumption automatically if
# that fetch fails for any reason.
USE_REALIZED_VOLATILITY=

# Optional: indexer read resilience. Defaults to 5 attempts with exponential
# backoff (3s, 6s, 12s, 24s between tries — ~45s total window). Raise these
# if the shared testnet indexer is degraded rather than just blipping.
INDEXER_RETRY_ATTEMPTS=
INDEXER_RETRY_BASE_DELAY_MS=
